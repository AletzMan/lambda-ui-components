{
	"name": "lambda-ui-components",
	"version": "1.1.0",
	"description": "Modern, accessible, and themeable React UI components library built with TypeScript and Framer Motion.",
	"license": "MIT",
	"sideEffects": false,
	"main": "dist/main.umd.js",
	"module": "dist/main.mjs",
